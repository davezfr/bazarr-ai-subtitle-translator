# OpenAI-compatible endpoint.
# For local Ollama, keep this shape and change the host if Ollama runs elsewhere.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama

# Model to use for translation.
SUBTRANS_MODEL=gemma4:latest

# Optional tuning.
SUBTRANS_CONTEXT_TOKENS=2000
SUBTRANS_TEMPERATURE=0
SUBTRANS_LOG_LEVEL=warn

# Set to 1 to overwrite existing .zh.srt files.
SUBTRANS_FORCE=0

