# OpenAI-compatible endpoint.
# For local Ollama, keep this shape and change the host if Ollama runs elsewhere.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama

# Model to use for translation.
SUBTRANS_MODEL=gemma4:latest

# Language direction.
SUBTRANS_SOURCE_LANGUAGE="English"
SUBTRANS_SOURCE_SUFFIXES=en,eng,english
SUBTRANS_TARGET_LANGUAGE="Simplified Chinese"
SUBTRANS_TARGET_SUFFIX=zh

# Output shape.
# SRT is target-language only. Bilingual output requires ASS.
SUBTRANS_OUTPUT_FORMAT=srt
SUBTRANS_OUTPUT_MODE=target

# Optional tuning.
SUBTRANS_CONTEXT_TOKENS=2000
SUBTRANS_TEMPERATURE=0
SUBTRANS_LOG_LEVEL=warn

# Optional V2 deterministic chunked translator tuning.
# Backend roles:
# - codex-cli: current stable local runner, requires local Codex auth
# - openai-compatible: long-term public API target via /chat/completions
SUBTRANS_BACKEND=openai-compatible
SUBTRANS_MAX_RETRIES=3
# Optional semantic alignment gate. Use "model" when you want the backend to
# check each translated chunk for cue-level meaning shifts after structure validation.
SUBTRANS_ALIGNMENT_CHECK=off

# Optional OpenAI-compatible endpoint backend.
# SUBTRANS_OPENAI_RESPONSE_FORMAT=json_schema
# SUBTRANS_OPENAI_TIMEOUT=300

# Optional ASS styling.
# SUBTRANS_ASS_PRIMARY_SCRIPT=cjk
# SUBTRANS_ASS_SECONDARY_SCRIPT=latin
# SUBTRANS_ASS_PRIMARY_SIZE=56
# SUBTRANS_ASS_SECONDARY_SIZE=36
# SUBTRANS_ASS_HEIGHT=1080
# SUBTRANS_ASS_MARGINV=55
# SUBTRANS_ASS_PRIMARY_FONT="PingFang SC"
# SUBTRANS_ASS_SECONDARY_FONT="Arial"

# Optional prompt files.
# OpenAI-compatible endpoint calls send the endpoint prompt as the system message.
# The format contract and style prompt are included in the user translation prompt.
# Use absolute paths when overriding these from Bazarr or Docker.
# SUBTRANS_ENDPOINT_PROMPT_FILE=/config/scripts/prompts/endpoint-format-contract-system.md
# SUBTRANS_FORMAT_PROMPT_FILE=/config/scripts/prompts/format-contract-system.md
# SUBTRANS_PROMPT_FILE=/config/scripts/prompts/xiaohu-style-system.md

# Set to 1 to overwrite existing output files.
SUBTRANS_FORCE=0
